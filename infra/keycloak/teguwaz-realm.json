{
  "realm": "teguwaz",
  "enabled": true,
  "displayName": "Teguwaz · ተጓዥ",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "am"
  ],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "teguwaz-web",
      "name": "Teguwaz web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "${TEGUWAZ_WEB_URL:http://localhost:5173}/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "${TEGUWAZ_WEB_URL:http://localhost:5173}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##${TEGUWAZ_WEB_URL:http://localhost:5173}/*"
      }
    },
    {
      "clientId": "teguwaz-backend",
      "name": "Teguwaz API (account deletion)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_BACKEND_SECRET:teguwaz-backend-dev-secret}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "meron",
      "email": "meron@example.com",
      "emailVerified": true,
      "firstName": "Meron",
      "lastName": "T.",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "teguwaz-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-teguwaz",
        "admin"
      ]
    },
    {
      "username": "abebe",
      "email": "abebe@example.com",
      "emailVerified": true,
      "firstName": "Abebe",
      "lastName": "K.",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "teguwaz-dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-teguwaz-backend",
      "enabled": true,
      "serviceAccountClientId": "teguwaz-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Teguwaz administrators: user management"
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "displayName": "Google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:set-GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:set-GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "hideOnLoginPage": "false",
        "guiOrder": "1"
      }
    }
  ],
  "identityProviderMappers": [],
  "registrationEmailAsUsername": true,
  "rememberMe": true
}